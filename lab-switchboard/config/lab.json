{
  "title": "Lab Switchboard",
  "clusterName": "lab-k8s-01",
  "namespaces": ["netpol-test", "rocky-desktop"],
  "managedLabel": "microsegmentation-lab/managed-by",
  "managedValue": "microsegmentation-iac",
  "dashboardLinks": [
    { "name": "Headlamp", "description": "Cluster resources, events and logs", "url": "http://localhost:18080", "icon": "network" },
    { "name": "Cockpit", "description": "Ubuntu host health and administration", "url": "https://localhost:19090", "icon": "gauge" }
  ],
  "guests": {
    "netpol-test/netpol-client": { "title": "Ubuntu client", "os": "Ubuntu 24.04", "user": "labadmin", "key": "netpol-client_ed25519", "knownHosts": "netpol-client_known_hosts", "ssh": true, "rdp": false },
    "netpol-test/netpol-server-rocky": { "title": "Rocky test server", "os": "Rocky Linux 10", "user": "labadmin", "key": "netpol-server-rocky_ed25519", "knownHosts": "netpol-server-rocky_known_hosts", "ssh": true, "rdp": false },
    "netpol-test/netpol-server-windows": { "title": "Windows server", "os": "Windows Server 2025", "ssh": false, "rdp": true, "rdpUser": "Administrator", "rdpPort": 13390 },
    "rocky-desktop/rocky-desktop": { "title": "Rocky desktop", "os": "Rocky Linux 9", "user": "labadmin", "key": "rocky-desktop_ed25519", "knownHosts": "rocky-desktop_known_hosts", "ssh": true, "rdp": true, "rdpCommand": "bash scripts/32-rocky-desktop/setup-rocky-desktop.sh --rdp", "rdpUser": "desktop", "rdpPort": 13389 }
  },
  "commands": [
    { "title": "Open Lab Switchboard", "detail": "Keep the portal's SSH tunnel running on this laptop.", "command": "bash lab-switchboard/scripts/access.sh" },
    { "title": "Open dashboard tunnels", "detail": "Keep this running in a host terminal.", "command": "bash scripts/45-monitoring-dashboard/access-dashboards.sh --host" },
    { "title": "Check lab progress", "detail": "Inventory and next steps; may ask to start the outer VM.", "command": "bash scripts/check-lab-progress.sh" },
    { "title": "Check cluster health", "detail": "Node, OVN, KubeVirt and CDI checks.", "command": "bash scripts/20-install-k3s-kubevirt/check-cluster-status.sh" },
    { "title": "Create Headlamp login token", "detail": "Writes a private token file under work/.", "command": "bash scripts/45-monitoring-dashboard/dashboard-permissions.sh token" },
    { "title": "Restore Headlamp read-only", "detail": "Restrict the shared dashboard account.", "command": "bash scripts/45-monitoring-dashboard/dashboard-permissions.sh read-only" },
    { "title": "Log into the outer VM", "detail": "Key-authenticated host shell.", "command": "bash scripts/10-create-lab-vm/login-lab-vm.sh" },
    { "title": "Start the outer VM", "detail": "Run from the physical host when the cluster is offline.", "command": "virsh -c qemu:///system start lab-k8s-01" },
    { "title": "Shut down the outer VM", "detail": "Stop nested guests first. This also takes the portal offline.", "command": "virsh -c qemu:///system shutdown lab-k8s-01" }
  ]
}