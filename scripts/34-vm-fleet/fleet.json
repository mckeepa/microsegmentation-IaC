{
  "namespacePrefix": "seg",
  "defaults": {
    "adminUser": "labadmin",
    "timezone": "UTC",
    "waitSeconds": 1200
  },
  "vms": [
    {
      "name": "web-ubuntu-01",
      "blueprint": "ubuntu-server",
      "cpu": 2,
      "memory": "2Gi",
      "disk": "10Gi",
      "labels": { "app": "web", "tier": "frontend", "env": "test" },
      "ports": [8080],
      "runState": "running",
      "owner": "paul",
      "purpose": "Baseline web target for microsegmentation policy tests"
    },
    {
      "name": "db-rocky-01",
      "blueprint": "rocky-server",
      "cpu": 2,
      "memory": "2Gi",
      "disk": "10Gi",
      "labels": { "app": "db", "tier": "backend", "env": "test" },
      "ports": [5432],
      "runState": "running",
      "owner": "paul",
      "purpose": "Baseline database target for microsegmentation policy tests"
    },
    {
      "name": "desktop-ubuntu-01",
      "blueprint": "ubuntu-desktop",
      "cpu": 4,
      "memory": "6Gi",
      "disk": "30Gi",
      "labels": { "app": "desktop", "tier": "client", "env": "test", "os": "ubuntu" },
      "runState": "stopped",
      "waitSeconds": 2400,
      "owner": "paul",
      "purpose": "Ubuntu GNOME desktop client for interactive microsegmentation tests"
    },
    {
      "name": "desktop-rocky-01",
      "blueprint": "rocky-desktop",
      "cpu": 4,
      "memory": "6Gi",
      "disk": "30Gi",
      "labels": { "app": "desktop", "tier": "client", "env": "test", "os": "rocky" },
      "runState": "stopped",
      "waitSeconds": 2400,
      "owner": "paul",
      "purpose": "Rocky XFCE desktop client for interactive microsegmentation tests"
    }
  ]
}
